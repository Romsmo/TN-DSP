# Regenerates the BLE contract vectors into OUT and compares them with the committed
# files in REF (line endings normalised). Run by CTest as "contract_vectors".
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${GEN}" "${OUT}" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "bdsp_gen_vectors failed (${rc})")
endif()
file(GLOB generated RELATIVE "${OUT}" "${OUT}/*.json")
set(bad "")
foreach(f ${generated})
  if(NOT EXISTS "${REF}/${f}")
    list(APPEND bad "${f} (missing in docs/contract/vectors)")
    continue()
  endif()
  file(READ "${OUT}/${f}" a)
  file(READ "${REF}/${f}" b)
  string(REPLACE "\r\n" "\n" a "${a}")
  string(REPLACE "\r\n" "\n" b "${b}")
  if(NOT a STREQUAL b)
    list(APPEND bad "${f} (differs)")
  endif()
endforeach()
if(bad)
  message(FATAL_ERROR "contract vectors out of date: ${bad}\nRegenerate with: bdsp_gen_vectors docs/contract/vectors")
endif()
