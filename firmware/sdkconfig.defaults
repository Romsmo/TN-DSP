# Reproducible defaults.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Phase A: no display, no BLE. Enable in menuconfig as phases land.
# CONFIG_BDSP_ENABLE_DISPLAY=y

# LVGL (used when the display is enabled) — config from this repo's ui/lv_conf.h.
CONFIG_LV_CONF_SKIP=n
