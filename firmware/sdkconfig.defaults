# Reproducible defaults.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_SPIRAM=n

# ── BlitzerdeDsp ────────────────────────────────────────────────────────────
CONFIG_BDSP_ENABLE_DISPLAY=y
CONFIG_BDSP_ENABLE_BLE=n
CONFIG_BDSP_FEATURE_SPEEDCAM=y

# ── LVGL 9 (firmware uses Kconfig; host uses ui/lv_conf.h) ──────────────────
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_OS=0
CONFIG_LV_DRAW_SW_ASM_NONE=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_USE_TILEVIEW=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
# no LVGL demos
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
