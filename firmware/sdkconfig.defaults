# Reproducible defaults. Target-specific overrides go in sdkconfig.defaults.esp32c6.
CONFIG_IDF_TARGET="esp32c6"

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# C++
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# BLE — NimBLE only (C6 has no Bluetooth Classic)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# No PSRAM on the C6.
# LVGL draw buffers are allocated from internal DMA-capable RAM (see hal_esp).

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Feature flags (Kconfig, see firmware/main/Kconfig.projbuild)
CONFIG_BDSP_FEATURE_SPEEDCAM=y
