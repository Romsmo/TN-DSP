{
  "contractVersion": "1.0.0",
  "description": "Rules the APP applies when it builds leftSigns / rightSigns for the display. The device renders the two lists exactly as sent; it applies none of these rules.",
  "labelSource": "Wikimedia Commons file titles of the vendored sign SVGs (checked 2026-10-24)",
  "codeFormula": "code = major * 100 + minor   (VzNr '142-10' -> 14210, '276' -> 27600)",
  "wire": {
    "maxSignsPerColumn": 4,
    "displayedSignsPerColumn": 3,
    "note": "The display shows the newest 3 of a column (last entries); anything older falls off."
  },
  "sideRule": {
    "left": "major VzNr in 200..299 (Vorschrift- and Verbotszeichen)",
    "right": "every other vendored sign (Gefahrzeichen, 100..199)"
  },
  "addAlgorithm": [
    "1. side = sideRule(vzNr)",
    "2. In BOTH columns remove every sign s with conflicts(vzNr, s)",
    "3. Append vzNr to the list of its side",
    "4. If that list now holds more than displayedSignsPerColumn entries, drop the oldest (first) ones"
  ],
  "conflictRule": "conflicts(new, other) is true if ANY holds: (a) both are members of the same family; (b) both have the same major VzNr (e.g. 101-11 and 101-15, or a sign and itself); (c) major(other) is listed in cancels[new]",
  "removeAlgorithm": "remove vzNr from whichever column holds it; nothing else changes",
