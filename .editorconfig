root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,cpp,h,hpp}]
indent_size = 4
max_line_length = 100

[*.{cmake,txt,py,yml,yaml,md}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
